PGHOST=localhost
PGPORT=5432
PGDATABASE=bike_dw
PGUSER=postgres
PGPASSWORD=your_password

# Tùy chọn: DATABASE_URL (nếu đặt) sẽ ghi đè các biến PG* ở trên.
# Local (Docker/Postgres cục bộ):
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/bike_dw
# Render, Internal Database URL (khi chạy trên Render):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/bike_dw
# Render, External Database URL (chạy từ máy bạn):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST.oregon-postgres.render.com/bike_dw?sslmode=require
