# Biến cần đặt thủ công trên Render (Web Service > Environment) khi KHÔNG dùng Blueprint (render.yaml).

# Bắt buộc: Internal Database URL của PostgreSQL trên Render
DATABASE_URL=postgresql://USER:PASSWORD@HOST/bike_dw

# Tùy chọn: chạy lại ETL mỗi lần khởi động (mặc định chỉ nạp khi kho trống)
# RUN_ETL=always

# Tùy chọn: origin khác được phép gọi API, cách nhau bằng dấu phẩy
# CORS_ORIGINS=https://dss.example.com
